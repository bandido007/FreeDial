# ════════════════════════════════════════════════════════════════════════════
#  Environment for this backend.  Copy to `.env` (git-ignored) and edit.
#
#  `make init` writes a `.env` for you with fresh SECRET_KEY / ENCRYPTION_KEYS.
#  Lines marked  ← REQUIRED IN PRODUCTION  are checked at start-up by
#  config/checks.py: the server refuses to boot with a development default.
#  Every value has a safe default for local work unless stated otherwise.
#  Keep comments on their own line: a value never carries a trailing comment.
# ════════════════════════════════════════════════════════════════════════════

# ── Identity ────────────────────────────────────────────────────────────────
# shown in e-mails, the admin, authenticator apps
PROJECT_NAME="AlgoDial"
# short machine name (log files, default sender address)
PROJECT_SLUG=algodial
# free-form label on log lines and error reports
ENVIRONMENT=development
# .production in deployments
DJANGO_SETTINGS_MODULE=config.settings.development

# ── Core ────────────────────────────────────────────────────────────────────
# ← REQUIRED IN PRODUCTION (≥ 50 chars)
SECRET_KEY=change-me-run-make-secret-key
# ← must be False in production
DEBUG=True
# ← REQUIRED IN PRODUCTION (exact host names, comma-separated)
ALLOWED_HOSTS=*
# sub-path when served under one, e.g. /api
SCRIPT_NAME=
# the API is also served under /<prefix>/ for gateways
API_MOUNT_PREFIX=backend
# public origin of the SPA (links in e-mails)
FRONTEND_DOMAIN=http://localhost:4200
# ← REQUIRED IN PRODUCTION (no localhost)
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200
TIME_ZONE=Africa/Dar_es_Salaam
# first = fallback; messages come from status_codes.json
API_LANGUAGES=en,sw
# the GraphiQL IDE + introspection (off in production)
GRAPHIQL=True
# exception text in API answers — NEVER in production
EXPOSE_ERROR_DETAILS=True
# proxies in front of the app (X-Forwarded-For hops to trust)
TRUSTED_PROXY_COUNT=0

# ── Database ────────────────────────────────────────────────────────────────
# ← REQUIRED IN PRODUCTION (real password)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5442/algodial
DB_CONN_MAX_AGE=60
# tests run on PostgreSQL (pytest creates and drops test_<name>)
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5442/algodial

# ── Cache / broker (Redis) ──────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6392/1
CELERY_BROKER_URL=redis://127.0.0.1:6392/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6392/2
# development only: run tasks inline, no worker needed
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
# /readyz also pings the broker when True
HEALTH_CHECK_BROKER=False

# ── Secrets at rest ─────────────────────────────────────────────────────────
# Fernet keys for stored secrets (SMTP/LDAP/SMS passwords, MFA secrets).
# Comma-separated; the FIRST key encrypts, every key decrypts — rotate by
# prepending a new key, then `manage.py rotate_secrets`, then drop the old one.
# ← REQUIRED IN PRODUCTION (`make encryption-key`)
ENCRYPTION_KEYS=

# ── Modules ─────────────────────────────────────────────────────────────────
# configurable approval processes
# this backend as an OpenID Connect provider
# the reference business app (remove in real projects)

# ── Sign-in & sessions ──────────────────────────────────────────────────────
# the first-party OAuth2 application (password grant)
OAUTH_APP_NAME="AlgoDial Web"
# fixed client_id for it (blank = generated on seed)
OAUTH_CLIENT_ID=
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=86400
# public register mutation (e-mail OTP verified)
ALLOW_SELF_REGISTRATION=True
# fields that must be filled before the account is "complete"
PROFILE_REQUIRED_FIELDS=first_name,last_name,phone
DEFAULT_PHONE_COUNTRY_CODE=255
# e-mail on sign-in from an unseen device
NEW_DEVICE_LOGIN_ALERT=True
# unverified self-registrations are purged after this
UNVERIFIED_ACCOUNT_TTL_DAYS=7
INVITE_TTL_HOURS=72
# bump to make everyone accept the terms again
CONSENT_TERMS_VERSION=2026-01
CONSENT_PRIVACY_VERSION=2026-01
# extra throw-away domains to refuse, comma-separated
DISPOSABLE_EMAIL_DOMAINS=

# Password policy (also editable at runtime on the System settings screen)
PASSWORD_MIN_LENGTH=8
# 0 = reuse allowed
PASSWORD_HISTORY_COUNT=5
# 0 = never expires
PASSWORD_MAX_AGE_DAYS=0
# k-anonymity lookup against Have I Been Pwned (needs egress)
PWNED_PASSWORD_CHECK=False
PASSWORD_RESET_TTL_MINUTES=30
# SPA route that receives the reset/invite token
PASSWORD_RESET_PATH=/auth/set-password

# Two-factor policy (also editable at runtime)
# e.g. System,Internal
MFA_REQUIRED_ACCOUNT_TYPES=
# role names, comma-separated
MFA_REQUIRED_ROLES=

# Brute-force protection (django-axes) + per-address login throttle
# ← must be True in production (development default off)
AXES_ENABLED=False
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
AXES_LOCK_OUT_AT_FAILURE=True
# lock the ACCOUNT; the address is covered by RL_LOGIN_*
AXES_LOCKOUT_PARAMETERS=username
RL_LOGIN_LIMIT=30
RL_LOGIN_WINDOW=300
RL_REGISTER_LIMIT=5
RL_REGISTER_WINDOW=300
RL_OTP_LIMIT=6
RL_OTP_WINDOW=600
RL_RESET_LIMIT=5
RL_RESET_WINDOW=900
RL_EXTERNAL_LIMIT=20
RL_EXTERNAL_WINDOW=300
RL_PUBLIC_FILE_LIMIT=120
RL_PUBLIC_FILE_WINDOW=60

# One-time codes (registration, e-mail change, account deletion)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_PER_DAY=8
OTP_RETENTION_DAYS=3

# ── External sign-in (this backend as an OIDC client) ───────────────────────
# shortcut: registers the "google" provider
GOOGLE_OAUTH_CLIENT_ID=
# OIDC_PROVIDERS={"corp":{"label":"Staff","issuer":"https://sso.example.org/realms/main","client_id":"portal","account_type":"Internal","allowed_domains":["example.org"],"auto_provision":false}}
# create accounts on first external sign-in
OIDC_AUTO_PROVISION=True

# ── Directory sign-in (LDAP / Active Directory) ─────────────────────────────
# Needs requirements/ldap.txt. Stored directory configurations are managed on
# the Directories screen; these variables configure a single global directory.
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_USER_FILTER=(mail=%(user)s)
LDAP_ACCOUNT_TYPE=Internal
LDAP_DEFAULT_ROLE=
# development: fabricate directory users — ← must be False in production
LDAP_SIMULATE_DIRECTORY=True

# the issuer (this backend's public origin)
# SPA route hosting the consent screen
# development only; production allows https
OAUTH_ALLOWED_REDIRECT_SCHEMES=http,https

# ── E-mail ──────────────────────────────────────────────────────────────────
# smtp.EmailBackend in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Django Starter <no-reply@algodial.local>"
# Branding of every HTML e-mail (header, footer)
EMAIL_BRAND_ORGANISATION=
EMAIL_BRAND_PORTAL=
EMAIL_BRAND_TAGLINE=
EMAIL_BRAND_LOGO_URL=
EMAIL_BRAND_WEBSITE=
EMAIL_BRAND_SUPPORT_EMAIL=
EMAIL_BRAND_ADDRESS=
EMAIL_BRAND_ACCENT=#0f5c50
EMAIL_BRAND_FROM_NAME=

# ── SMS ─────────────────────────────────────────────────────────────────────
# log instead of sending — ← must be False in production
SMS_ALLOW_LOG_PROVIDER=True
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_SYSTEM_ID=
SMS_SERVICE_CODE=
NOTIFICATION_MAX_ATTEMPTS=5

# ── Files ───────────────────────────────────────────────────────────────────
# local | s3 (needs requirements/production.txt)
STORAGE_BACKEND=local
MEDIA_URL=/media/
STATIC_URL=/static/
S3_BUCKET_NAME=
# MinIO / other S3-compatible endpoint
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_SIGNED_URL_TTL_SECONDS=300
ATTACHMENT_MAX_IMAGE_MB=5
ATTACHMENT_MAX_DOCUMENT_MB=15
# storage prefixes served without a token
ATTACHMENT_PUBLIC_BUCKETS=public
DATA_UPLOAD_MAX_MB=25
# host:port of a clamd; blank = no virus scan
CLAMAV_ADDRESS=
# refuse uploads when the scanner is unreachable
CLAMAV_FAIL_CLOSED=True

# ── GraphQL limits ──────────────────────────────────────────────────────────
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_COMPLEXITY=500
GRAPHQL_MAX_ALIASES=15
GRAPHQL_MAX_ROOT_FIELDS=10
GRAPHQL_BATCH_ENABLED=False
GRAPHQL_MAX_BATCH_SIZE=10
GRAPHQL_MAX_PAGE_SIZE=500
RBAC_PERMISSION_CACHE_SECONDS=300

# ── Audit & logs ────────────────────────────────────────────────────────────
AUDIT_TRACKED_PREFIXES=/graphql,/oauth2/,/files/
# False = log only warnings and errors
AUDIT_PERSIST_SUCCESS_REQUESTS=True
AUDIT_INFO_RETENTION_DAYS=14
AUDIT_WARNING_RETENTION_DAYS=60
# unresolved errors are never purged
AUDIT_RESOLVED_ERROR_RETENTION_DAYS=180
# 0 = keep the change trail forever
AUDIT_TRAIL_RETENTION_DAYS=0
LOG_LEVEL=INFO
# text | json (production default: json)
LOG_FORMAT=text
# development: logs/<slug>.log as well
LOG_TO_FILE=True
# error tracking when set (needs sentry-sdk)
SENTRY_DSN=

# ── Browser security headers ────────────────────────────────────────────────
# CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'
# for the admin and GraphiQL pages
# CONTENT_SECURITY_POLICY_HTML=...
# PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()
# production only
SECURE_SSL_REDIRECT=True
# production only
SECURE_HSTS_SECONDS=31536000

# ── First administrator (`make seed`) ───────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@example.org
# blank = no administrator is created
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FIRST_NAME=System
DEFAULT_ADMIN_LAST_NAME=Administrator

# ── Build-time only ─────────────────────────────────────────────────────────
# lets a build step (e.g. collectstatic on a build box) load the production module without secrets; never on a running service
# SKIP_PRODUCTION_CHECKS=1

# ── project ── AlgoDial ─────────────────────────────────────────────────────
# Everything below is AlgoDial's own; starter updates never touch it.
# Call control: Asterisk's ARI (http.conf binds 8091; 8088 belongs to InfluxDB on the lab machine)
ARI_URL=http://127.0.0.1:8091/ari
ARI_USER=algodial
# the [algodial] password in /etc/asterisk/ari.conf
ARI_PASSWORD=
ARI_APP=algodial
# Redis Streams between web, brain and writer (database 4 of the compose Redis)
BUS_REDIS_URL=redis://127.0.0.1:6392/4
BUS_COMMANDS_STREAM=algodial:commands
BUS_EVENTS_STREAM=algodial:events
# PJSIP realtime (apps.telephony): Asterisk source tree with contrib/ast-db-manage
ASTERISK_SRC_DIR=/home/administrator/asterisk-22
PJSIP_REALM=asterisk
PJSIP_DEFAULT_CONTEXT=lab
PJSIP_TRANSPORT_SOFTPHONE=transport-udp
PJSIP_TRANSPORT_BROWSER=transport-wss
# read-only role Asterisk uses (res_pgsql.conf); manage.py pjsip_schema creates it
ASTERISK_DB_USER=asterisk
ASTERISK_DB_PASSWORD=
