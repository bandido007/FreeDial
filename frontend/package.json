{
  "name": "algodial-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4240 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write src *.json *.ts",
    "format:check": "prettier --check src *.json *.ts"
  },
  "dependencies": {
    "@angular/animations": "22.2.0",
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/material": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-browser-dynamic": "22.2.0",
    "@angular/router": "22.2.0",
    "@apollo/client": "3.13.1",
    "@ngrx/effects": "22.0.1",
    "@ngrx/entity": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@ngx-translate/core": "15.0.0",
    "apollo-angular": "11.0.0",
    "graphql": "16.10.0",
    "graphql-tag": "2.12.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "jsdom": "30.1.1",
    "prettier": "3.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "apollo-angular": {
      "@angular/core": "$@angular/core"
    }
  },
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.15.0 || >=26.0.0"
  }
}
